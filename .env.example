PORT=5000
FLASK_DEBUG=false
SECRET_KEY=troque-esta-chave
COOKIE_SECURE=false

DEFAULT_USER_LOGIN=operador
DEFAULT_USER_NAME=Operador de Campo
# Gere com: python app.py --hash "sua-senha"
DEFAULT_USER_PASSWORD_HASH=

# Tanques em arquivo JSON local
TANKS_JSON_PATH=tanques.json

# Aba fallback quando o tanque nao tiver sheet_tab
DEFAULT_REGISTROS_TAB=BOLETIM BA

# Apps Script Web App (obrigatorio)
APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/AKfycbyB3qR-MVQpTWTUIYN3c8lL566Z8aE2MZ_ipy2n_sRb2f3zcLAUNy1oO6aRUD8-afCK/exec

# Envio para grupo WhatsApp via webhook (opcional)
# Ex: servico interno que recebe { text, ... } e publica no grupo
WHATSAPP_GROUP_WEBHOOK_URL=
WHATSAPP_GROUP_WEBHOOK_TOKEN=
WHATSAPP_GROUP_TIMEOUT_SEC=12





