DEFAULT_USER_PASSWORD_HASH=

# Tanques em arquivo JSON local
TANKS_JSON_PATH=tanques.json

# Aba fallback quando o tanque nao tiver sheet_tab
DEFAULT_REGISTROS_TAB=BOLETIM BA

